{
  "name": "libmork",
  "version": "0.1.0",
  "description": "Aplicativo de RPG de mesa com sistema de regras próprio",
  "author": "João Silva <joao.silvaoliver240@gmail.com>",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "electron:compile": "tsc -p electron/tsconfig.json && esbuild electron/main.ts electron/preload.ts --bundle --platform=node --external:electron --outdir=dist-electron --allow-overwrite",
    "electron:start": "electron dist-electron/main.js",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000/api/health && npm run electron:compile && npm run electron:start\"",
    "electron:build": "npm run electron:compile",
    "electron:dist": "npm run electron:compile && electron-builder --win --x64",
    "electron:dist:all": "npm run electron:compile && electron-builder -mwl",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:setup": "node scripts/setup-db.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@3d-dice/dice-box-threejs": "0.0.12",
    "@auth/drizzle-adapter": "^1.11.3",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@tanstack/react-virtual": "^3.14.13",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "dexie": "^4.4.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.37.0",
    "next": "16.4.5",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.9",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-grid-layout": "^2.2.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^14.0.2",
    "zod": "^4.5.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.31.10",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.8",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.libmork.desktop",
    "productName": "Libmork",
    "copyright": "Copyright © 2026 João Silva",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "electron/gateway/**/*",
      "electron/assets/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Libmork"
    },
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg"
      ],
      "icon": "electron/assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "electron/assets/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "joaoSilva240",
      "repo": "libmork"
    }
  }
}
