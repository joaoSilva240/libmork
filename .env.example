# =============================================================================
# Libmork — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local no repositório.
# =============================================================================

# --- Banco de Dados (PostgreSQL — D-34) ---
# Exemplo local; preencha com os valores do seu ambiente.
# Não inclua credenciais reais neste arquivo.
# Banco lógico esperado: libmork; confirme sua existência antes das migrations:
DATABASE_URL=postgresql://user:password@localhost:5432/libmork

# --- Autenticação (D-44 — Cookies HTTP-only) ---
# Chave secreta para assinar cookies de sessão (mínimo 32 caracteres)
AUTH_SECRET=change-me-to-a-random-256-bit-hex-string

# --- OAuth Google (RF-003) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Aplicação ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Tradução via 9Router (OpenAI-compatible) ---
# URL do provedor de tradução 9Router (compatível OpenAI)
# Em produção, use URL pública via Funnel/Cloudflare Tunnel ou Tailscale sidecar
# Em dev local, use IP Tailnet ou http://host.docker.internal:20128/v1
NINEROUTER_URL=http://localhost:20128/v1
NINEROUTER_KEY=your-9router-api-key
NINEROUTER_MODEL=ollama/gpt-oss:120b

# --- Diagnóstico opcional (Token para /api/health/ninerouter sem sessão) ---
# Útil para ZimaOS healthcheck externo: curl -H "x-health-token: $HEALTH_TOKEN" /api/health/ninerouter
HEALTH_TOKEN=

# --- Upload de Imagens (D-33) ---
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=5

# --- Observabilidade ---
LOG_LEVEL=debug
REDIS_URL=redis://localhost:6379
