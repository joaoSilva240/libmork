# =============================================================================
# Libmork — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local no repositório.
# =============================================================================

# --- Banco de Dados (PostgreSQL externo — D-34) ---
# Seu PostgreSQL está rodando em 100.122.171.83:5432
# Credenciais: casaos/casaos
# Você deve criar o banco 'libmork' antes de rodar as migrations:
# psql -h 100.122.171.83 -U casaos -c "CREATE DATABASE libmork;"
DATABASE_URL=postgresql://casaos:casaos@100.122.171.83:5432/libmork

# --- Autenticação (D-44 — Cookies HTTP-only) ---
# Chave secreta para assinar cookies de sessão (mínimo 32 caracteres)
AUTH_SECRET=change-me-to-a-random-256-bit-hex-string

# --- OAuth Google (RF-003) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Aplicação ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Upload de Imagens (D-33) ---
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=5
